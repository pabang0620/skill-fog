{
  "name": "skill-fog",
  "version": "2.0.5",
  "description": "Auto-detect usage patterns and generate Claude Code skills, commands, and agents",
  "scripts": {
    "postinstall": "node postinstall.js"
  },
  "bin": {
    "skill-fog": "./bin/skill-fog"
  },
  "keywords": [
    "claude-code",
    "skill",
    "agent",
    "automation",
    "pattern-detection"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pabang0620/skill-fog.git"
  },
  "homepage": "https://github.com/pabang0620/skill-fog#readme",
  "bugs": {
    "url": "https://github.com/pabang0620/skill-fog/issues"
  },
  "files": [
    "bin/",
    "hooks/",
    "SKILL.md",
    "references/*.md",
    "install.sh",
    "uninstall.sh",
    "postinstall.js",
    "README.md",
    "CHANGELOG.md",
    "docs/troubleshooting.md",
    "docs/release-checklist.md",
    "docs/benchmarks/hook-baseline.md",
    "scripts/bench-hook.sh",
    "scripts/run-evals.sh",
    "scripts/score-patterns.py",
    "scripts/eval-artifacts.py",
    "fixtures/transcripts/*.jsonl",
    "fixtures/patterns/*.json",
    "fixtures/artifacts/*.json",
    "skill-fog.metadata.json"
  ]
}
